# Node
node_modules/
*.log
npm-debug.log*

# Python (foreign virtualenv kept out per WORKFLOW Q2 / P-08)
.venv/
__pycache__/

# Editor / OS
.DS_Store
*.swp
.vscode/
.idea/

# Aggregator output — derivative of consumer harvests; regenerate with
# scripts/aggregate-metrics.py rather than committing snapshots.
docs/aggregated-metrics.html

# orchestra per-project state — consumer-side artifacts must never appear
# in the plugin repo. Release-gate prerequisite per PRD §11.2 / §12.
# Parent-dir pattern: the plugin repo has no legitimate runtime artifacts
# under .claude/.orchestra/ (covers local.yaml, metrics/, sessions/,
# DRIFT-REPORT.md, SUMMARY-*.md, and any other generated outputs).
.claude/.orchestra/

# Audit / temp scratch — derivative outputs from /audit-* skills and
# audit subagents (per-component JSON, aggregate MD, HTML reports).
# Regenerate; do not commit.
.claude/audit/
.claude/temp/

# Reuse-check hook cache — sha256-keyed reviewer verdicts (1h TTL).
# Dev-only; never ships. Runtime creates the dir on first miss.
.claude/.cache/

# Reuse-check hook deps — @anthropic-ai/claude-agent-sdk lives under
# .claude/hooks/ to keep the SDK out of the plugin's shipping surface.
# Dev-only; never ships.
.claude/hooks/node_modules/
.claude/hooks/package-lock.json

# mcp-servers/ allow-list. Only the two shipped MCP servers are tracked;
# anything else under mcp-servers/ is accidental and must not be packaged.
mcp-servers/*
!mcp-servers/orchestra-utils.js
!mcp-servers/orchestra-probe.js
