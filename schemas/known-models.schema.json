{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra:known-models",
  "title": "orchestra known-models manifest",
  "description": "Closed list of short canonical model names that agent frontmatter may reference. Short names (opus/sonnet/haiku) are canonical; the fully-qualified Anthropic id lives in model_id for API routing.",
  "type": "object",
  "required": ["models"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["id", "model_id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": ["opus", "sonnet", "haiku"]
        },
        "model_id": {
          "type": "string"
        },
        "default": { "type": "boolean" }
      }
    }
  }
}
